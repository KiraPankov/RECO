# Справочный список параметров конвейера RECO.
# Приложение НЕ читает этот файл: значения заданы в коде (src/mobile/android, пакет engine)
# и повторены в tools/eval/pipeline.py. Файл нужен, чтобы параметры были видны в одном месте.
# Не добавляйте .env с секретами в Git.

# Аудио
SAMPLE_RATE=16000
DC_REMOVAL_WINDOW_S=0.1
NORMALIZE_PERCENTILE=99.9
NORMALIZE_TARGET=0.9
NORMALIZE_MAX_GAIN=30

# Диаризация (pyannote segmentation 3.0 + 3D-Speaker CAM++)
DIARIZATION_CLUSTER_THRESHOLD=0.7
DIARIZATION_NUM_SPEAKERS=auto

# Разрез по паузам (Silero VAD)
VAD_THRESHOLD=0.7
VAD_MIN_PAUSE_S=0.2

# Второй проход уточнения говорящих
REFINE_MIN_CHUNK_S=0.5
REFINE_CENTROID_MIN_CHUNK_S=1.0
REFINE_MERGE_COSINE=0.75

# Нарезка и сборка реплик
MIN_CHUNK_S=0.3
MERGE_SAME_SPEAKER_GAP_S=0.8
MAX_CHUNK_S=28
MERGE_REPLICA_GAP_S=1.5

# Модели
ASR_MODEL=parakeet-tdt-0.6b-v3-int8
LLM_MODEL=qwen3-0.6b-int4-litertlm
LLM_MAX_INPUT_CHARS=600
LLM_KV_CACHE_TOKENS=1280
